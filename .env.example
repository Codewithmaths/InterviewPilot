# Groq (copy this file to .env and fill in values)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database — Supabase (PostgreSQL). Required.
# Supabase dashboard: Project Settings -> Database -> Connection string.
# Use the "Session pooler" URI (works over IPv4). Tables are created
# automatically on first startup — no SQL needed.
# Remove ?pgbouncer=true&connection_limit=1 from the dashboard string if present
# (libpq/psycopg2 does not accept those query params).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSLMODE=require
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Face analysis interval in seconds
FACE_ANALYSIS_INTERVAL=1.0

# Speech-to-text
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Pre-load Whisper + MediaPipe models at startup (production recommended, off in tests)
ML_MODEL_WARMUP=true

# ---------------------------------------------------------------------------
# Production / Oracle Cloud deployment overrides
# ---------------------------------------------------------------------------
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000
# FRONTEND_URL=https://interviewpilot.duckdns.org
# CORS_ORIGINS=https://interviewpilot.duckdns.org
# LOG_LEVEL=INFO

# Frontend (for docs / proxy)
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
FRONTEND_URL=http://127.0.0.1:5173

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Logging
LOG_LEVEL=INFO
